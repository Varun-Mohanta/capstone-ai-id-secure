# Copy to .env and fill in. Never commit .env.
# Used only by refresh_token_rotation_test.py (falls back to 02-iam-design/.env).
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.securenova.ai
AUTH0_WEB_CLIENT_ID=
AUTH0_WEB_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:3000/callback
AUTH0_SCOPE=openid profile email offline_access read:ai-data
EXPECTED_ACCESS_TTL=300
REFRESH_REUSE_WAIT=2

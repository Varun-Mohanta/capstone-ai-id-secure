<mxfile host="app.diagrams.net">
  <diagram id="tm-v3" name="Threat Model v3 - STRIDE">
    <mxGraphModel dx="1920" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1500" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Dashed rectangles are trust boundaries; the DFD nodes are positioned inside them. -->
        <mxCell id="b-user" value="USER / FRONTEND BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="35" width="300" height="235" as="geometry" /></mxCell>
        <mxCell id="b-idp" value="IDENTITY PROVIDER BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="295" width="250" height="125" as="geometry" /></mxCell>
        <mxCell id="b-backend" value="APPLICATION BACKEND BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="350" y="35" width="670" height="385" as="geometry" /></mxCell>
        <mxCell id="b-agent" value="AGENT RUNTIME TRUST BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="650" y="80" width="340" height="215" as="geometry" /></mxCell>
        <mxCell id="b-api" value="INTERNAL API TRUST BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1035" y="35" width="210" height="175" as="geometry" /></mxCell>
        <mxCell id="b-rag" value="RAG PIPELINE TRUST BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1270" y="35" width="600" height="385" as="geometry" /></mxCell>
        <mxCell id="b-mcp" value="MCP SERVER TRUST BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1035" y="240" width="210" height="180" as="geometry" /></mxCell>
        <mxCell id="b-ext" value="EXTERNAL PROVIDER BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fillColor=none;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="650" y="315" width="340" height="105" as="geometry" /></mxCell>

        <mxCell id="n-user" value="User" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#EAF2FB;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="95" width="100" height="55" as="geometry" /></mxCell>
        <mxCell id="n-ui" value="User Interface" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175" y="95" width="120" height="55" as="geometry" /></mxCell>
        <mxCell id="n-auth0" value="Auth0 Tenant" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FFF4E5;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="125" y="330" width="140" height="55" as="geometry" /></mxCell>
        <mxCell id="n-backend" value="Chatbot Backend Endpoint" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="105" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n-harness" value="AI Chatbot Harness" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#EFE9F7;strokeColor=#6C4BA0;strokeWidth=1.5;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="725" y="130" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n-secrets" value="Secrets Manager" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="125" height="75" as="geometry" /></mxCell>
        <mxCell id="n-chatdb" value="Chat Session DB" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="280" width="125" height="75" as="geometry" /></mxCell>
        <mxCell id="n-llm" value="LLM Provider" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FCE8E6;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="345" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="n-api" value="Internal REST APIs" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#E6F4F1;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="95" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="n-rag" value="RAG Service" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#EEF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="95" width="145" height="60" as="geometry" /></mxCell>
        <mxCell id="n-vector" value="Vector Store" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1640" y="90" width="150" height="90" as="geometry" /></mxCell>
        <mxCell id="n-embed" value="Embedding Service" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="270" width="145" height="55" as="geometry" /></mxCell>
        <mxCell id="n-mcp" value="MCP Server" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FFF9DB;strokeColor=#2F5597;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="300" width="140" height="55" as="geometry" /></mxCell>

        <mxCell id="f-user-ui" value="User interaction" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-user" target="n-ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-ui-auth" value="OIDC authorize with PKCE / code callback" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-ui" target="n-auth0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-auth-be" value="Authorization code, verifier; ID/access tokens" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-auth0" target="n-backend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-ui-be" value="Chat request: session cookie; response" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-ui" target="n-backend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-be-harness" value="Request + validated user context / response" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-backend" target="n-harness"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-be-db" value="Read/write session data" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-backend" target="n-chatdb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-secret-agent" value="M2M credential + LLM API key" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-secrets" target="n-harness"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-agent-api" value="M2M token + least-privilege scope / API response" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-harness" target="n-api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-agent-llm" value="Prompt over TLS + key in auth header / model response" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-harness" target="n-llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-agent-rag" value="Query with agent identity / retrieved text" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-harness" target="n-rag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-rag-embed" value="Embedding request / response" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-rag" target="n-embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-rag-vector" value="Scoped search / retrieved chunks" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-rag" target="n-vector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-agent-mcp" value="Tool request with agent identity / result" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-harness" target="n-mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-mcp-api" value="Tool call with MCP identity / tool result" style="endArrow=block;html=1;rounded=1;strokeColor=#404040;fontSize=10;" edge="1" parent="1" source="n-mcp" target="n-api"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="stride-title" value="STRIDE THREAT COMPONENT - IDENTITY FLOWS" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#7A1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="700" height="35" as="geometry" /></mxCell>
        <mxCell id="stride-note" value="Initial threat annotations for the highest-risk identity paths. In Threat Dragon, assess each DFD flow against all six categories; record a threat or a justified N/A for each category." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1780" height="35" as="geometry" /></mxCell>
        <mxCell id="stride-header-cat" value="STRIDE" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="155" height="38" as="geometry" /></mxCell>
        <mxCell id="stride-header-flow" value="Identity flow / asset" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="195" y="545" width="330" height="38" as="geometry" /></mxCell>
        <mxCell id="stride-header-threat" value="Example threat scenario" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="545" width="560" height="38" as="geometry" /></mxCell>
        <mxCell id="stride-header-control" value="Mitigation" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1085" y="545" width="560" height="38" as="geometry" /></mxCell>
        <mxCell id="stride-header-owner" value="Owner" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1645" y="545" width="175" height="38" as="geometry" /></mxCell>

        <mxCell id="stride-s" value="S - Spoofing" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F3F7EE;strokeColor=#999999;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="583" width="155" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-s-flow" value="OIDC callback; M2M token; MCP identity" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="583" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-s-threat" value="Attacker replays a stolen session or presents a forged/wrong-audience token as a trusted user or workload." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="583" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-s-control" value="Validate issuer, signature, audience, expiry and scopes; bind callback state/nonce; use distinct workload credentials." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="583" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-s-owner" value="IAM / Backend" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1645" y="583" width="175" height="90" as="geometry" /></mxCell>

        <mxCell id="stride-t" value="T - Tampering" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F3F7EE;strokeColor=#999999;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="673" width="155" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-t-flow" value="PKCE/callback; tool arguments; RAG chunks" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="673" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-t-threat" value="Authorization data, tool arguments, or retrieved content is modified and trusted as authentic input." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="673" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-t-control" value="Enforce PKCE and state checks; validate tool schemas and authorization server-side; validate and provenance-tag ingested RAG content." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="673" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-t-owner" value="Backend / RAG" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1645" y="673" width="175" height="90" as="geometry" /></mxCell>

        <mxCell id="stride-r" value="R - Repudiation" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F3F7EE;strokeColor=#999999;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="763" width="155" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-r-flow" value="M2M/API calls; MCP tool requests" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="763" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-r-threat" value="A privileged action cannot be attributed to a user, agent, service identity, or specific tool invocation." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="763" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-r-control" value="Create access-controlled, tamper-evident audit logs with subject/client ID, scopes, tool/action, request ID, result, and timestamp." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="763" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-r-owner" value="SecOps / Backend" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1645" y="763" width="175" height="90" as="geometry" /></mxCell>

        <mxCell id="stride-i" value="I - Info Disclosure" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F3F7EE;strokeColor=#999999;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="853" width="155" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-i-flow" value="Secrets to agent; prompt/LLM; RAG retrieval" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="853" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-i-threat" value="LLM key, access token, prompt content, session data, or cross-user RAG chunks leak to an unauthorized party." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="853" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-i-control" value="Keep secrets out of prompts/logs; redact credentials; minimize sent data; enforce tenant/document-level retrieval authorization." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="853" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-i-owner" value="Platform / RAG" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1645" y="853" width="175" height="90" as="geometry" /></mxCell>

        <mxCell id="stride-d" value="D - Denial of Service" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F3F7EE;strokeColor=#999999;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="943" width="155" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-d-flow" value="Auth0; LLM; RAG; MCP requests" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="943" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-d-threat" value="Abusive or repeated requests exhaust token, model, retrieval, or tool-service capacity and deny service to legitimate users." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="943" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-d-control" value="Apply per-user and per-agent quotas, request/token limits, timeouts, concurrency caps, and circuit breakers." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="943" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-d-owner" value="Platform / SRE" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1645" y="943" width="175" height="90" as="geometry" /></mxCell>

        <mxCell id="stride-e" value="E - Elevation of Privilege" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#F3F7EE;strokeColor=#999999;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1033" width="155" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-e-flow" value="User/agent tokens to APIs; agent to MCP tools" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="1033" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-e-threat" value="A user-level identity or compromised agent invokes an admin API or a tool beyond its approved privilege." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="1033" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-e-control" value="Authorize every action at the API/tool boundary; require audience and least-privilege scopes; separate user and workload identities." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="1033" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="stride-e-owner" value="IAM / API owner" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1645" y="1033" width="175" height="90" as="geometry" /></mxCell>

        <mxCell id="stride-footer" value="STRIDE is a structured review, not a severity score. Full flow-by-flow assessment (14 flows x 6 categories = 84 entries: 81 threats, 3 justified N/A) is in STRIDE-Matrix.md and the OWASP Threat Dragon model SecureNova-Threat-Dragon.json." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1780" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        <mxCell id="v12" value="&lt;b&gt;AT3&lt;/b&gt; [AND] Manipulate agent behaviour via RAG chunk poisoning&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;LLM01 | AML.T0070&lt;/font&gt;&lt;br&gt;&lt;b&gt;L4 x I4 = 16&lt;/b&gt; (High)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#C00000;strokeWidth=3;fontSize=12;" vertex="1" parent="1">

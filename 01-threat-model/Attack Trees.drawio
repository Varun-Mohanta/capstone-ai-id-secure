        <mxCell id="v18" value="&lt;b&gt;3.1.1&lt;/b&gt; Submit via a normal ingestion source (KB article, ticket, upload)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;T-F13-T | AML.T0070&lt;/font&gt;&lt;br&gt;&lt;b&gt;L4 x I4 = 16&lt;/b&gt; (High)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#C00000;strokeWidth=3;" vertex="1" parent="1">
